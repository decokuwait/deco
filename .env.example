# ---------- Platform ----------
# Root/main domain of the platform (no protocol). Sites live on *.ROOT_DOMAIN or on custom domains.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Comma separated emails that become super admins on first login/creation
SUPER_ADMIN_EMAILS=owner@example.com
# Initial super admin password used by `npm run db:seed` and by the first-login bootstrap (min 8 chars, not a placeholder)
SUPER_ADMIN_PASSWORD=
# Optional: demo sites created by `npm run db:seed:demo` (local evaluation). In production the password is required.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
# Optional: 64 hex chars (openssl rand -hex 32). When set, ad-platform tokens/secrets are encrypted at rest (AES-256-GCM).
PIXEL_SECRET_KEY=
# Optional: unlocks the deployment detail of /api/health (pending migrations, region, storage verdict) and
# the ?probe=upload write test for an uptime monitor. A signed-in super admin always sees the same detail;
# without either, /api/health answers only {"ok":..,"database":".."}.
HEALTH_TOKEN=

# ---------- Database (Supabase Postgres) ----------
# Supabase -> Project Settings -> Database -> Connection string (Transaction pooler, port 6543)
# Leave EMPTY locally to use the embedded PGlite database in ./.data (no Supabase needed for dev/tests)
DATABASE_URL=
# Optional: run pending migrations on boot under an advisory lock (prefer `npm run db:migrate` at deploy time)
AUTO_MIGRATE=false
# Optional: postgres.js pool size per serverless instance (default 3)
DATABASE_POOL_MAX=3

# ---------- Storage (Cloudflare R2) ----------
# Leave EMPTY locally to store uploads on local disk (./.data/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=decokuwait
# Public base URL of the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_URL=

# ---------- Vercel (automatic domain / subdomain provisioning) ----------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
