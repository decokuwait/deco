# ---------- Platform ----------
# Root/main domain of the platform (no protocol). Sites live on *.ROOT_DOMAIN or on custom domains.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Comma separated emails that become super admins on first login/creation
SUPER_ADMIN_EMAILS=owner@example.com
# Initial super admin password used by `npm run db:seed` and by the first-login bootstrap (min 8 chars, not a placeholder)
SUPER_ADMIN_PASSWORD=
# Optional: demo sites created by `npm run db:seed:demo` (local evaluation). In production the password is required.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
# Optional: 64 hex chars (openssl rand -hex 32). When set, ad-platform tokens/secrets are encrypted at rest (AES-256-GCM).
PIXEL_SECRET_KEY=
# Optional: unlocks the deployment detail of /api/health (pending migrations, region, storage verdict) and
# the ?probe=upload write test for an uptime monitor. A signed-in super admin always sees the same detail;
# without either, /api/health answers only {"ok":..,"database":".."}.
HEALTH_TOKEN=

# ---------- Database (Supabase Postgres) ----------
# Supabase -> Project Settings -> Database -> Connection string (Transaction pooler, port 6543)
# Leave EMPTY locally to use the embedded PGlite database in ./.data (no Supabase needed for dev/tests)
DATABASE_URL=
# Optional: run pending migrations on boot under an advisory lock (prefer `npm run db:migrate` at deploy time)
AUTO_MIGRATE=false
# Optional: postgres.js pool size per serverless instance (default 3)
DATABASE_POOL_MAX=3

# ---------- Storage (Cloudflare R2) ----------
# Leave EMPTY locally to store uploads on local disk (./.data/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=decokuwait
# Public base URL of the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_URL=

# ---------- Vercel (automatic domain / subdomain provisioning) ----------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ---------- Error tracking ----------
# Every server error already goes to the function log as one greppable line:
#   [dk:error] source=.. path=.. digest=.. message=..
# `digest` is the same code the error page shows the visitor, so a screenshot maps to a log line.
#
# Optional: set SENTRY_DSN to forward those errors to Sentry as well. `@sentry/nextjs` is NOT a dependency
# of this project — install it first (`npm i @sentry/nextjs`), then set the DSN. Until both are true the
# reporter stays console-only and says so once per boot in the deploy log.
SENTRY_DSN=
# Optional: report through a different package than @sentry/nextjs (e.g. @sentry/node on a worker).
SENTRY_MODULE=

# ---------- Ad platform APIs ----------
# Meta Graph API version used by the Conversions API.
#
# Meta retires each version about two years after it ships, and a call to a retired version does not
# degrade — it fails, for every tenant, on a date fixed in advance. It used to be `v21.0` hard-coded in
# src/lib/marketing/providers/meta.ts, with a sunset of 2027-01-21.
#
# Bump this when Meta announces the next sunset (Graph API changelog). The value must look like
# `v23.0`; anything else is ignored in favour of the built-in default. When a version does expire, the
# admin panel reports it as its own alarm ("api_version"), not as a generic red badge.
META_GRAPH_VERSION=v23.0

# ---------- Billing & scheduled jobs ----------
# Secret for the Vercel Cron jobs declared in vercel.json (/api/cron/billing, /api/cron/maintenance).
# Vercel sends it as `Authorization: Bearer $CRON_SECRET` on every scheduled invocation, and the routes
# compare it timing-safely. WITHOUT IT THE CRON ROUTES REFUSE EVERY CALLER (503) except a signed-in super
# admin — they are never publicly triggerable. Generate one with: openssl rand -hex 32
CRON_SECRET=
#
# Optional: override the published price list without a deploy. JSON, amounts in FILS (1 KWD = 1000 fils).
# Anything missing or malformed falls back to the built-in list in src/lib/billing.ts — never to zero.
# Default: basic 15/150, pro 25/250, plus 40/400 KWD (monthly/yearly).
# BILLING_PRICES_FILS={"basic":{"monthly":15000,"yearly":150000},"pro":{"monthly":25000,"yearly":250000},"plus":{"monthly":40000,"yearly":400000}}
BILLING_PRICES_FILS=
# Optional: one-off setup fee in fils (default 50000 = KD 50). Waived automatically on a yearly prepayment.
BILLING_SETUP_FEE_FILS=
#
# ---------- MyFatoorah (optional — KNET / cards / Apple Pay) ----------
# LEAVE EMPTY and billing runs in manual/offline mode: the "generate payment link" button mints a cash
# reference (CASH-YYMMDD-XXXX) the founder records against the site after taking cash or a KNET transfer.
# Nothing is installed for this — there is no MyFatoorah package dependency and the build does not need it.
# Set the key and the same button creates a real MyFatoorah invoice and returns a link to paste into WhatsApp.
MYFATOORAH_API_KEY=
# Optional: use the sandbox host (apitest.myfatoorah.com) instead of the Kuwaiti live host.
MYFATOORAH_TEST=false
# Optional: override the API base URL entirely (default https://api-kw.myfatoorah.com).
MYFATOORAH_BASE_URL=

# --- security ---
# Total bytes one site may hold in the media bucket, in megabytes. /api/upload sums
# media_assets.size and refuses the upload that would take the site past this, so one
# authenticated admin cannot mint presigned PUTs of 300 MB each without limit.
# Optional; 5120 (5 GB) when unset.
SITE_STORAGE_QUOTA_MB=
